# ---------------------------------------------------------------------------
# Environment template for the UFA landing page.
#
# The public landing page itself requires NO environment variables.
# Everything below belongs to the backend integration (Jagdeep).
#
# Rules:
#  - Only NON-SECRET values may use the NEXT_PUBLIC_ prefix. Anything prefixed
#    NEXT_PUBLIC_ is baked into the browser bundle and is visible to anyone.
#  - Never put service-role keys, private URLs, passwords, or tokens in a
#    NEXT_PUBLIC_ variable.
#  - Supabase keys and all backend configuration are Jagdeep's responsibility.
#  - Copy this file to .env.local for local work. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# Supabase (backend owner: Jagdeep) — DO NOT prefix keys with NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public, non-secret frontend configuration (safe to expose)
NEXT_PUBLIC_SITE_URL=
